<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.leydisystems.menuarboles.controller.MenuController"
        style="-fx-background-color: #0f172a;">

    <top>
        <VBox spacing="10"
              style="-fx-background-color: #111c34;
                     -fx-padding: 28 36 24 36;">

            <Label text="MENÚ DE ÁRBOLES"
                   style="-fx-text-fill: white;
                          -fx-font-size: 30px;
                          -fx-font-weight: bold;"/>

            <Label text="Estructuras de datos | JavaFX"
                   style="-fx-text-fill: #cbd5e1;
                          -fx-font-size: 15px;"/>

            <Label text="Selecciona una estructura para comenzar"
                   style="-fx-text-fill: #94a3b8;
                          -fx-font-size: 13px;"/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="18"
                  vgap="18"
                  alignment="CENTER"
                  maxWidth="850">

            <padding>
                <Insets top="25" right="25"
                        bottom="25" left="25"/>
            </padding>

            <columnConstraints>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.33"/>
            </columnConstraints>

            <Button text="ÁRBOL BINARIO&#10;Inserción y recorridos"
                    onAction="#openBinaryTree"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="0"
                    style="-fx-background-color: #2563eb;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 16;
                           -fx-pref-width: 240;
                           -fx-pref-height: 140;
                           -fx-cursor: hand;"/>

            <Button text="ÁRBOL DE BÚSQUEDA&#10;Ordena por valores"
                    onAction="#openBST"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="1"
                    style="-fx-background-color: #059669;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 16;
                           -fx-pref-width: 240;
                           -fx-pref-height: 140;
                           -fx-cursor: hand;"/>

            <Button text="ÁRBOL AVL&#10;Balance automático"
                    onAction="#openAVL"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="2"
                    style="-fx-background-color: #7c3aed;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 16;
                           -fx-pref-width: 240;
                           -fx-pref-height: 140;
                           -fx-cursor: hand;"/>

            <Button text="HEAP MÍNIMO&#10;Consultar y extraer mínimo"
                    onAction="#openHeap"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="0"
                    style="-fx-background-color: #d97706;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 16;
                           -fx-pref-width: 240;
                           -fx-pref-height: 140;
                           -fx-cursor: hand;"/>

            <Button text="ÁRBOL B&#10;Claves ordenadas"
                    onAction="#openBTree"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="1"
                    style="-fx-background-color: #db2777;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 16;
                           -fx-pref-width: 240;
                           -fx-pref-height: 140;
                           -fx-cursor: hand;"/>

            <Button text="TRIE&#10;Búsqueda de palabras"
                    onAction="#openTrie"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="2"
                    style="-fx-background-color: #0891b2;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 16;
                           -fx-pref-width: 240;
                           -fx-pref-height: 140;
                           -fx-cursor: hand;"/>

        </GridPane>
    </center>

    <bottom>
        <Label text="MenuArboles | Proyecto JavaFX"
               BorderPane.alignment="CENTER"
               style="-fx-text-fill: #64748b;
                      -fx-padding: 16;"/>
    </bottom>

</BorderPane>